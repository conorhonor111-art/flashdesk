# FlashDesk relay — Caddy config.
# Caddy terminates TLS (certificate obtained and renewed automatically) and forwards to the relay
# service on 127.0.0.1:5000, which is never exposed to the internet directly.
# Logs go to the systemd journal on purpose: the packaged service sandbox forbids /var/log.
#   journalctl -u caddy -f
#
# NOTE for whoever edits this next: a route not listed here falls through to the static page and
# returns 404. And Caddy does NOT accept one-line blocks — the { must be followed by a newline.

relay.flashdesk.org {
	encode gzip

	handle /health {
		reverse_proxy 127.0.0.1:5000
	}

	handle /usage {
		reverse_proxy 127.0.0.1:5000
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:5000
	}

	# Where sessions live. Long-lived WebSocket; no read timeout may cut a session short.
	handle /ws {
		reverse_proxy 127.0.0.1:5000
	}

	handle {
		root * /var/www/relay
		file_server
	}
}
