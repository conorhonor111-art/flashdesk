<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0-WINDOWS since 2026-08-06, and it is a deliberate change. The host's file service is
         the first code in this project that opens a stranger's disk, and its safety checks
         (LocalDrives, the OpenedPath handle re-check) can only exist in the Host project because
         they need DriveInfo and Win32. A neutral test assembly could not reference them, which
         would have left exactly the code with the worst failure mode as the only code with no
         tests. RemoteDesktop.Shared itself is UNCHANGED and stays platform-neutral (architecture
         rule 4) — the Linux relay still references it; only the tests moved. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RemoteDesktop.Shared\RemoteDesktop.Shared.csproj" />
    <ProjectReference Include="..\RemoteDesktop.Host\RemoteDesktop.Host.csproj" />
  </ItemGroup>

</Project>
