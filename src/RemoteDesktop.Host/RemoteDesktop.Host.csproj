<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- The product name a client sees: the exe is FlashDesk.exe. Namespaces, project and folder
         names deliberately stay RemoteDesktop (renaming them is churn with breakage risk and no
         visible gain — recorded as a separate later task in CLAUDE.md). -->
    <AssemblyName>FlashDesk</AssemblyName>
    <ApplicationIcon>..\..\assets\FlashDesk.ico</ApplicationIcon>

    <!-- File properties a person sees on right-click → Properties → Details, and one of the few
         free signals SmartScreen and antivirus engines read. A blank-properties exe looks worse
         to both. Launching UNSIGNED is a deliberate decision (2026-08-03): signing does not
         remove the SmartScreen warning, it only lets reputation start accruing, and reputation
         needs real downloads we do not have yet. See CLAUDE.md "Code signing and SmartScreen". -->
    <Product>FlashDesk</Product>
    <!-- AssemblyTitle becomes the Win32 "File description" — the line Windows shows in Task
         Manager AND in the SmartScreen dialog itself, so it must read as a sentence a worried
         person can understand, not as a filename. -->
    <AssemblyTitle>FlashDesk remote support</AssemblyTitle>
    <Description>FlashDesk — remote support. Shows your 9-digit number so someone you trust can see and control your screen while you watch.</Description>
    <Company>FlashDesk</Company>
    <Copyright>Copyright © 2026 FlashDesk</Copyright>
    <Version>0.3.1</Version>
    <FileVersion>0.3.1.0</FileVersion>
    <AssemblyVersion>0.3.1.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Both icons embedded so MainForm can swap the window/taskbar icon at runtime: idle disc
         normally, amber-badged LIVE while a viewer is connected (extends hard rule 2 to the
         taskbar). The exe-file icon above stays idle — a closed app cannot be live. -->
    <EmbeddedResource Include="..\..\assets\FlashDesk.ico" LogicalName="FlashDesk.AppIcon" />
    <EmbeddedResource Include="..\..\assets\FlashDesk-live.ico" LogicalName="FlashDesk.AppIconLive" />
  </ItemGroup>

  <ItemGroup>
    <!-- The file service and its two safety checks are internal on purpose — nothing outside this
         project may reach a stranger's disk — but they are also the code in this program with the
         worst failure mode, so the tests are let in. -->
    <InternalsVisibleTo Include="RemoteDesktop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RemoteDesktop.Shared\RemoteDesktop.Shared.csproj" />
    <ProjectReference Include="..\RemoteDesktop.UI\RemoteDesktop.UI.csproj" />
    <!-- The operator half, merged in 2026-08-03: ONE FlashDesk.exe does both jobs, like AnyDesk.
         RemoteDesktop.Viewer is now a library holding the session window, the video canvas and
         the input capture — the hardest-won code in the project, moved without being rewritten. -->
    <ProjectReference Include="..\RemoteDesktop.Viewer\RemoteDesktop.Viewer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <!-- DPAPI, for encrypting the FlashDesk secret at rest under the current Windows account. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
