<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- The product name a client sees: the exe is FlashDesk.exe. Namespaces, project and folder
         names deliberately stay RemoteDesktop (renaming them is churn with breakage risk and no
         visible gain — recorded as a separate later task in CLAUDE.md). -->
    <AssemblyName>FlashDesk</AssemblyName>
    <ApplicationIcon>..\..\assets\FlashDesk.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Both icons embedded so MainForm can swap the window/taskbar icon at runtime: idle disc
         normally, amber-badged LIVE while a viewer is connected (extends hard rule 2 to the
         taskbar). The exe-file icon above stays idle — a closed app cannot be live. -->
    <EmbeddedResource Include="..\..\assets\FlashDesk.ico" LogicalName="FlashDesk.AppIcon" />
    <EmbeddedResource Include="..\..\assets\FlashDesk-live.ico" LogicalName="FlashDesk.AppIconLive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RemoteDesktop.Shared\RemoteDesktop.Shared.csproj" />
    <ProjectReference Include="..\RemoteDesktop.UI\RemoteDesktop.UI.csproj" />
    <!-- The operator half, merged in 2026-08-03: ONE FlashDesk.exe does both jobs, like AnyDesk.
         RemoteDesktop.Viewer is now a library holding the session window, the video canvas and
         the input capture — the hardest-won code in the project, moved without being rewritten. -->
    <ProjectReference Include="..\RemoteDesktop.Viewer\RemoteDesktop.Viewer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <!-- DPAPI, for encrypting the FlashDesk secret at rest under the current Windows account. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
